[Unit]
Description=Extract firmware from the stock Android partitions
Documentation=file:/usr/local/sbin/a40-firmware-extract
# Before udev loads the WiFi and modem drivers, so their firmware is there
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-udev-trigger.service sysinit.target shutdown.target
Conflicts=shutdown.target
ConditionPathExists=!/var/lib/a40-firmware/done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/a40-firmware-extract

[Install]
WantedBy=sysinit.target
