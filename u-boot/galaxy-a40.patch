new file mode 100644
index 00000000000..53e834bb12b
--- /dev/null
+++ b/arch/arm/dts/exynos7885-galaxy-a40-u-boot.dtsi
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * A40-specific U-Boot overlay: properties S-BOOT looks at, and the
+ * framebuffer S-BOOT already set up (reused as the U-Boot console).
+ *
+ * Copyright (c) 2026 Mikhael Skvortsov <mikhael.skvortsov@gmail.com>
+ */
+
+/ {
+	/*
+	 * Required by S-BOOT on the 7870 phones. The A40's S-BOOT appears
+	 * lenient (our Linux chain-load boots with a DTB that omits these),
+	 * but set them best-effort. model_info-chip is a guess from the SoC
+	 * family - VERIFY on device; if S-BOOT rejects the image, this value
+	 * (or hw_rev range) is the first thing to fix.
+	 */
+	model_info-chip = <7885>;
+	model_info-hw_rev = <0>;
+	model_info-hw_rev_end = <255>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * The simple-framebuffer S-BOOT leaves running on the A40
+		 * (0xec000000, 1080x2340, a8r8g8b8) - the same surface Linux
+		 * uses for the tty0 console. U-Boot's VIDEO_SIMPLE binds here
+		 * so U-Boot output lands on the screen without a UART jig.
+		 */
+		framebuffer@ec000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xec000000 (1080 * 2340 * 4)>;
+			width = <1080>;
+			height = <2340>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+};
+
+/*
+ * Only probe the ALIVE pinctrl instance. DISPAUD / FSYS / TOP pinctrl
+ * blocks sit in power domains that may not be clocked by the time U-Boot
+ * probes them, causing hangs. The key GPIOs (gpa1) and eMMC pins are all
+ * in the ALIVE domain so disabling the others has no functional cost.
+ */
+&pinctrl_dispaud { status = "disabled"; };
+&pinctrl_fsys { status = "disabled"; };
+&pinctrl_top { status = "disabled"; };
+
+/*
+ * eMMC (mmc_0): clocks come from cmu_fsys (CLK_GOUT_MMC_EMBD_ACLK /
+ * CLK_GOUT_MMC_EMBD_SDCLKIN) via the exynos7885 clock driver.
+ * S-BOOT already powered, muxed, and enabled the eMMC; we inherit that
+ * state and only need to set bus geometry and timing parameters.
+ */
+&mmc_0 {
+	bus-width = <8>;
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 4>;
+	samsung,dw-mshc-ddr-timing = <2 4>;
+	mmc-hs200-1_8v;
+	non-removable;
+	status = "okay";
+};
+
+/*
+ * I2C1 (0x13840000) carries the S2MU005 MUIC at addr 0x3d.  We bring this
+ * bus up to inspect/control the MUIC's USB/UART data-path switch
+ * (SW_CTRL @0xB5): on this Type-C phone the USB2 D+/D- route through the
+ * MUIC, and if it is not in USB-path mode the host never sees the device
+ * no matter how the DWC3/PHY are configured.
+ *
+ * cmu_peri is not modelled in U-Boot's clock driver, but S-Boot leaves the
+ * I2C1 PCLK running (it uses the MUIC during boot).  Feed the s3c i2c
+ * driver a fixed input rate so it can compute the bus divider; 200 MHz is
+ * >= the real PERI_BUS rate, so the resulting SCL stays at/below the
+ * 100 kHz target (over-estimating only makes SCL slower, which is safe).
+ * The I2C1 pins (gpp1-2/3) sit in pinctrl_top, which we keep disabled, so
+ * drop the pinctrl reference and rely on S-Boot's pin muxing.
+ */
+/ {
+	i2c1_ipclk: clock-i2c1-ipclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+	};
+};
+
+&i2c_1 {
+	status = "okay";
+	clocks = <&i2c1_ipclk>;
+	clock-names = "i2c";
+	clock-frequency = <100000>;
+	/delete-property/ pinctrl-names;
+	/delete-property/ pinctrl-0;
+
+	s2mu005_muic: s2mu005@3d {
+		compatible = "samsung,s2mu005-muic";
+		reg = <0x3d>;
+	};
+};
