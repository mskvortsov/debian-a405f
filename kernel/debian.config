# Additions to defconfig + exynos7870.config + exynos7885.config, kept
# here rather than in the kernel tree. scripts/build-kernel.sh merges
# this after them and fails if a symbol does not end up as set here.

CONFIG_WIREGUARD=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
