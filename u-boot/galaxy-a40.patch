 }
 
+/*
+ * Samsung A40 USB-C data path: the USB2 D+/D- route through the if-PMIC
+ * MUIC's internal switch (I2C1 @0x13840000, addr 0x3d).  Linux sets the
+ * path in software on cable attach; U-Boot has no such driver, so it stays
+ * at whatever S-Boot left.  A40 is exynos7904, whose MUIC is an S2MU106
+ * (per exynos7904-m30lte: i2c@13840000/s2mu106@3d), though some 7885
+ * variants use S2MU005.  Both sit at 0x3d but differ in register map:
+ *
+ *   S2MU106: CTRL1=0x6d  MANUAL_SW_CTRL=0x70  (DM[7:5]/DP[4:2]/JIG[0])
+ *   S2MU005: CTRL1=0xB2  SW_CTRL=0xB5         (DM[7:5]/DP[4:2]/CHG[1]/OTG[0])
+ *
+ * USB path value is 0x24 (DM=001,DP=001) on both.  This first pass is
+ * diagnostic only: scan the bus to confirm it works and read both candidate
+ * switch regs read-only; no writes until we know the chip and the bus is
+ * proven alive (current symptom: read of 0x3d returns -121 EREMOTEIO).
+ */
+#define A40_MUIC_I2C_PATH	"/soc@0/i2c@13840000"
+#define A40_MUIC_ADDR		0x3d
+/* S2MU106 MUIC registers (this phone is exynos7904 / S2MU106, not S2MU005). */
+#define A40_MUIC_CTRL1		0x6d	/* bit2 MANUAL_SW: 0=manual 1=auto */
+#define A40_MUIC_MANSW		0x70	/* D-[7:5]/D+[4:2] path select */
+#define A40_MUIC_MANSW_USB	0x24	/* (USB<<5)|(USB<<2), USB=001 */
+/*
+ * Clean manual-mode CTRL1: SWITCH_OPEN(b4) | WAIT(b1), MANUAL_SW(b2)=0 => manual.
+ * Matches the downstream s2mu106 driver's reg_init value (0x12).  S-Boot leaves
+ * CTRL1=0x99 with TX_DPDM_SHORT(b7) and RAW_DATA(b3) set, which short/route the
+ * lines for charger detection instead of passing clean USB - clear them.
+ */
+#define A40_MUIC_CTRL1_MANUAL	0x12
+
+/*
+ * The I2C1 pins (gpp1-2 = SDA, gpp1-3 = SCL) live in pinctrl_top, which we keep
+ * disabled (its power domain can hang U-Boot at probe), so the pinctrl driver
+ * never muxes them and S-Boot apparently left them in a non-I2C function -
+ * the bus scan returns 0 devices (SDA/SCL float).  Program the gpp1 CON
+ * register directly to put both pins in function 2 (I2C1) before any transfer.
+ *
+ *   pinctrl_top base   0x139b0000
+ *   gpp1 bank offset   0x040  -> CON at 0x139b0040
+ *   pin field          4 bits each; pin2 = bits[11:8], pin3 = bits[15:12]
+ *   I2C1 function      2
+ * Board I2C pull-ups keep SDA/SCL high, so muxing CON is sufficient.
+ */
+#define A40_GPP1_CON		0x139b0040
+
+/*
+ * USB PHY / DRD clock gates in CMU_FSYS (base 0x13400000).  The PHY's UTMI
+ * analogue reference is CLK_FSYS_USB20PHY_CLKCORE - but the DT wires the PHY
+ * driver's "ref" clock to a fixed-clock shim (for FSEL detection), so the
+ * driver's clk_prepare_enable() is a no-op and this real gate is referenced by
+ * nothing.  S-Boot never used USB, so it may have left these gated off, leaving
+ * the PHY PLL without a reference (never locks -> link stuck Disconnected).
+ * Read them back (diagnostic) and force them on before USB bring-up.  bit21 = en.
+ */
+#define A40_CMU_FSYS_BASE		0x13400000
+/*
+ * USB PLL (PLL_USB / PLL_OUT_USB).  The downstream PHY DT wires the PHY refclk
+ * ("phy_refclk = out_usb") to this PLL's output; the working driver enables it.
+ * U-Boot doesn't model it, so nobody locks it - and if S-Boot never used USB it
+ * may be disabled, leaving the HS PHY without a reference (PLL never locks ->
+ * link permanently Disconnected, zero events - exactly our symptom).
+ * CON0 @ CMU_FSYS+0x1a0: bit31 ENABLE, bit29 STABLE(lock), M[25:16] P[13:8] S[2:0].
+ */
+#define A40_PLL_LOCKTIME_PLL_USB	(A40_CMU_FSYS_BASE + 0x0000)
+#define A40_PLL_CON0_PLL_USB		(A40_CMU_FSYS_BASE + 0x01a0)
+#define A40_PLL_USB_ENABLE		BIT(31)
+#define A40_PLL_USB_STABLE		BIT(29)
+#define A40_PLL_USB_MUX_SEL		BIT(4)	/* route PLL output, not bypass */
+/* PLL_USB target 50 MHz from 26 MHz OSC: M=400 P=13 S=4 (downstream pms table). */
+#define A40_PLL_USB_M			400
+#define A40_PLL_USB_P			13
+#define A40_PLL_USB_S			4
+#define A40_GAT_USB20PHY_CLKCORE	(A40_CMU_FSYS_BASE + 0x200c)
+#define A40_GAT_USB30DRD_ACLK_20PHYCTRL	(A40_CMU_FSYS_BASE + 0x2068)
+#define A40_GAT_USB30DRD_BUS_CLK_EARLY	(A40_CMU_FSYS_BASE + 0x2074)
+#define A40_GAT_USB30DRD_REF_CLK	(A40_CMU_FSYS_BASE + 0x2078)
+#define A40_CMU_GATE_EN			BIT(21)
+
+static void a40_enable_usb_pll(void)
+{
+	u32 con0 = readl(A40_PLL_CON0_PLL_USB);
+	u32 val;
+	int i;
+
+	/* Already enabled, locked and at the right ratio?  Leave it alone. */
+	if ((con0 & A40_PLL_USB_ENABLE) && (con0 & A40_PLL_USB_STABLE) &&
+	    ((con0 >> 16) & 0x3ff) == A40_PLL_USB_M)
+		return;
+
+	/*
+	 * S-Boot never used USB, so PLL_USB is completely unconfigured (CON0=0).
+	 * Program lock time (PDIV * 150, the pll_1418x convention), then the
+	 * dividers + MUX_SEL + ENABLE, and wait for the STABLE (lock) bit.
+	 */
+	writel(A40_PLL_USB_P * 150, A40_PLL_LOCKTIME_PLL_USB);
+
+	val = A40_PLL_USB_ENABLE | A40_PLL_USB_MUX_SEL |
+	      (A40_PLL_USB_M << 16) | (A40_PLL_USB_P << 8) | A40_PLL_USB_S;
+	writel(val, A40_PLL_CON0_PLL_USB);
+
+	for (i = 0; i < 10000; i++) {
+		if (readl(A40_PLL_CON0_PLL_USB) & A40_PLL_USB_STABLE)
+			break;
+		udelay(1);
+	}
+}
+
+static void a40_enable_usb_phy_clocks(void)
+{
+	const u32 gates[] = {
+		A40_GAT_USB20PHY_CLKCORE,
+		A40_GAT_USB30DRD_ACLK_20PHYCTRL,
+		A40_GAT_USB30DRD_BUS_CLK_EARLY,
+		A40_GAT_USB30DRD_REF_CLK,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(gates); i++)
+		writel(readl(gates[i]) | A40_CMU_GATE_EN, gates[i]);
+}
+
+static void a40_mux_i2c1_pins(void)
+{
+	u32 con = readl(A40_GPP1_CON);
+
+	con &= ~0x0000ff00;			/* clear pin2 + pin3 fields */
+	con |=  0x00002200;			/* pin2=func2, pin3=func2  */
+	writel(con, A40_GPP1_CON);
+}
+
+static void a40_muic_force_usb_path(void)
+{
+	struct udevice *bus, *dev;
+	ofnode node;
+	int ret;
+	u8 v;
+
+	a40_mux_i2c1_pins();
+
+	node = ofnode_path(A40_MUIC_I2C_PATH);
+	if (!ofnode_valid(node))
+		return;
+	if (uclass_get_device_by_ofnode(UCLASS_I2C, node, &bus))
+		return;
+	if (i2c_get_chip(bus, A40_MUIC_ADDR, 1, &dev))
+		return;
+
+	/*
+	 * S2MU106 data-path switch.  S-Boot leaves CTRL1=0x99 (RAW_DATA /
+	 * TX_DPDM_SHORT, charger-detect) and a split MANSW (D- on UART), so the
+	 * host can't enumerate.  Put CTRL1 in clean manual mode and route both
+	 * D+/D- to USB:
+	 *   CTRL1(0x6d): SWITCH_OPEN|WAIT, MANUAL_SW=0 (manual)        => 0x12
+	 *   MANSW(0x70): D-[7:5]/D+[4:2] = USB(001) each, keep [1:0]   => (old&3)|0x24
+	 */
+	v = A40_MUIC_CTRL1_MANUAL;
+	dm_i2c_write(dev, A40_MUIC_CTRL1, &v, 1);
+
+	ret = dm_i2c_read(dev, A40_MUIC_MANSW, &v, 1);
+	if (ret)
+		return;
+	v = (v & 0x03) | A40_MUIC_MANSW_USB;
+	dm_i2c_write(dev, A40_MUIC_MANSW, &v, 1);
+}
+
+/*
+ * Board hook called from the fastboot/g_dnl path (cmd/fastboot.c) after the
+ * UDC is probed and before the enumeration loop.  The DM_USB_GADGET path
+ * never calls board_usb_init(), so this is the spot that actually runs (and
+ * prints) during 'fastboot usb 0'.  Use it to route the MUIC to USB; always
+ * report the cable as present so fastboot proceeds.
+ */
+int g_dnl_board_usb_cable_connected(void)
+{
+	a40_muic_force_usb_path();
+
+	return 1;
+}
+
 int misc_init_r(void)
 {
 	int ret;
 
+	/*
+	 * Push our debug output below the display's rounded corners / camera
+	 * cutout so the top lines aren't clipped in screen photos.
+	 */
+	puts("\n\n\n");
+
+	/*
+	 * Route the MUIC data-path switch to USB *before* any USB bring-up.
+	 * The fastboot path asserts the D+ pullup (RUNSTOP) in g_dnl_register,
+	 * which happens before the g_dnl_board_usb_cable_connected() hook, so
+	 * fixing the path only in that hook is too late - the host already saw a
+	 * malformed connect (D+ up, D- on UART) and stops retrying.  Doing it
+	 * here means the very first connect the host sees has both D+/D- on USB.
+	 */
+	a40_enable_usb_pll();
+	a40_enable_usb_phy_clocks();
+	a40_muic_force_usb_path();
+
 	exynos_env_setup();
 
 	ret = exynos_blk_env_setup();
