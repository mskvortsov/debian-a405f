@@ -487,6 +656,9 @@ static int exynos_usbdrd_phy_init(struct phy *phy)
 	case EXYNOS850_USBDRD_PHY:
 		exynos850_usbdrd_utmi_init(phy);
 		break;
+	case EXYNOS7885_USBDRD_PHY:
