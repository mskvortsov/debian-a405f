diff --git a/drivers/clk/exynos/clk-exynos7885.c b/drivers/clk/exynos/clk-exynos7885.c
new file mode 100644
index 00000000000..688394de496
--- /dev/null
+++ b/drivers/clk/exynos/clk-exynos7885.c
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Exynos7885 clock driver for U-Boot.
+ *
+ * Covers CMU_TOP and CMU_FSYS — the minimal set needed to enumerate
+ * the eMMC (CLK_GOUT_MMC_EMBD_ACLK / SDCLKIN) and provides the
+ * foundation for adding more clock domains later.
+ *
+ * Register offsets and clock IDs are taken from the Linux kernel driver
+ * (drivers/clk/samsung/clk-exynos7885.c) and the dt-bindings header
+ * (include/dt-bindings/clock/exynos7885.h).
+ *
+ * Copyright (C) 2026 Mikhael Skvortsov <mikhael.skvortsov@gmail.com>
+ */
+
+#include "linux/clk-provider.h"
+#include <dm.h>
+#include <asm/io.h>
+#include <dt-bindings/clock/exynos7885.h>
+#include "clk.h"
+
+enum exynos7885_cmu_id {
+	CMU_TOP,
+	CMU_FSYS,
+};
+
+/* ---- CMU_TOP (0x12060000) ------------------------------------------ */
+
+#define PLL_CON0_PLL_SHARED0				0x0100
+#define PLL_CON0_PLL_SHARED1				0x0120
+
+#define CLK_CON_MUX_MUX_CLKCMU_FSYS_BUS		0x1028
+#define CLK_CON_MUX_MUX_CLKCMU_FSYS_MMC_EMBD		0x1030
+#define CLK_CON_MUX_MUX_CLKCMU_FSYS_USB30DRD		0x1038
+
+#define CLK_CON_DIV_PLL_SHARED0_DIV2			0x189c
+#define CLK_CON_DIV_PLL_SHARED1_DIV2			0x18ac
+#define CLK_CON_DIV_CLKCMU_FSYS_BUS			0x1844
+#define CLK_CON_DIV_CLKCMU_FSYS_MMC_EMBD		0x184c
+#define CLK_CON_DIV_CLKCMU_FSYS_USB30DRD		0x1854
+#define CLK_CON_DIV_PLL_SHARED0_DIV4			0x18a4
+#define CLK_CON_DIV_PLL_SHARED1_DIV4			0x18b4
+
+#define CLK_CON_GAT_GATE_CLKCMU_FSYS_BUS		0x2044
+#define CLK_CON_GAT_GATE_CLKCMU_FSYS_MMC_EMBD		0x204c
+#define CLK_CON_GAT_GATE_CLKCMU_FSYS_USB30DRD		0x2054
+
+static const struct samsung_pll_clock top_pll_clks[] = {
+	PLL(pll_1417x, CLK_FOUT_SHARED0_PLL, "fout_shared0_pll", "oscclk",
+	    PLL_CON0_PLL_SHARED0),
+	PLL(pll_1417x, CLK_FOUT_SHARED1_PLL, "fout_shared1_pll", "oscclk",
+	    PLL_CON0_PLL_SHARED1),
+};
+
+/* Step 1: select between oscclk and fout_*_pll (PLL_CON0 bit 4) */
+PNAME(mout_shared0_pll_p)	= { "oscclk", "fout_shared0_pll" };
+PNAME(mout_shared1_pll_p)	= { "oscclk", "fout_shared1_pll" };
+
+static const struct samsung_mux_clock top_pll_mux_clks[] = {
+	MUX(CLK_MOUT_SHARED0_PLL, "mout_shared0_pll", mout_shared0_pll_p,
+	    PLL_CON0_PLL_SHARED0, 4, 1),
+	MUX(CLK_MOUT_SHARED1_PLL, "mout_shared1_pll", mout_shared1_pll_p,
+	    PLL_CON0_PLL_SHARED1, 4, 1),
+};
+
+/* Step 2: /2 and /4 dividers off the PLL outputs */
+static const struct samsung_div_clock top_pll_div_clks[] = {
+	DIV(CLK_DOUT_SHARED0_DIV2, "dout_shared0_div2", "mout_shared0_pll",
+	    CLK_CON_DIV_PLL_SHARED0_DIV2, 0, 1),
+	DIV(CLK_DOUT_SHARED1_DIV2, "dout_shared1_div2", "mout_shared1_pll",
+	    CLK_CON_DIV_PLL_SHARED1_DIV2, 0, 1),
+	DIV(CLK_DOUT_SHARED0_DIV4, "dout_shared0_div4", "mout_shared0_pll",
+	    CLK_CON_DIV_PLL_SHARED0_DIV4, 0, 2),
+	DIV(CLK_DOUT_SHARED1_DIV4, "dout_shared1_div4", "mout_shared1_pll",
+	    CLK_CON_DIV_PLL_SHARED1_DIV4, 0, 2),
+};
+
+/* Step 3: route PLL outputs to FSYS subsystem */
+PNAME(mout_fsys_bus_p)		= { "dout_shared0_div2", "dout_shared1_div2" };
+PNAME(mout_fsys_mmc_embd_p)	= { "dout_shared0_div2", "dout_shared1_div2" };
+PNAME(mout_fsys_usb30drd_p)	= { "dout_shared0_div4", "dout_shared1_div4" };
+
+static const struct samsung_mux_clock top_fsys_mux_clks[] = {
+	MUX(CLK_MOUT_FSYS_BUS, "mout_fsys_bus", mout_fsys_bus_p,
+	    CLK_CON_MUX_MUX_CLKCMU_FSYS_BUS, 0, 1),
+	MUX(CLK_MOUT_FSYS_MMC_EMBD, "mout_fsys_mmc_embd", mout_fsys_mmc_embd_p,
+	    CLK_CON_MUX_MUX_CLKCMU_FSYS_MMC_EMBD, 0, 1),
+	MUX(CLK_MOUT_FSYS_USB30DRD, "mout_fsys_usb30drd", mout_fsys_usb30drd_p,
+	    CLK_CON_MUX_MUX_CLKCMU_FSYS_USB30DRD, 0, 1),
+};
+
+/* Step 4: gates feeding the FSYS domain */
+static const struct samsung_gate_clock top_fsys_gate_clks[] = {
+	GATE(CLK_GOUT_FSYS_BUS, "gout_fsys_bus", "mout_fsys_bus",
+	     CLK_CON_GAT_GATE_CLKCMU_FSYS_BUS, 21,
+	     CLK_IS_CRITICAL | CLK_SET_RATE_PARENT, 0),
+	GATE(CLK_GOUT_FSYS_MMC_EMBD, "gout_fsys_mmc_embd", "mout_fsys_mmc_embd",
+	     CLK_CON_GAT_GATE_CLKCMU_FSYS_MMC_EMBD, 21,
+	     CLK_IS_CRITICAL | CLK_SET_RATE_PARENT, 0),
+	GATE(CLK_GOUT_FSYS_USB30DRD, "gout_fsys_usb30drd", "mout_fsys_usb30drd",
+	     CLK_CON_GAT_GATE_CLKCMU_FSYS_USB30DRD, 21,
+	     CLK_IS_CRITICAL | CLK_SET_RATE_PARENT, 0),
+};
+
+/* Step 5: output dividers — these are what CMU_FSYS user muxes receive */
+static const struct samsung_div_clock top_fsys_div_clks[] = {
+	DIV(CLK_DOUT_FSYS_BUS, "dout_fsys_bus", "gout_fsys_bus",
+	    CLK_CON_DIV_CLKCMU_FSYS_BUS, 0, 4),
+	DIV(CLK_DOUT_FSYS_MMC_EMBD, "dout_fsys_mmc_embd", "gout_fsys_mmc_embd",
+	    CLK_CON_DIV_CLKCMU_FSYS_MMC_EMBD, 0, 9),
+	DIV(CLK_DOUT_FSYS_USB30DRD, "dout_fsys_usb30drd", "gout_fsys_usb30drd",
+	    CLK_CON_DIV_CLKCMU_FSYS_USB30DRD, 0, 4),
+};
+
+static const struct samsung_clk_group top_cmu_clks[] = {
+	{ S_CLK_PLL,  top_pll_clks,       ARRAY_SIZE(top_pll_clks) },
+	{ S_CLK_MUX,  top_pll_mux_clks,   ARRAY_SIZE(top_pll_mux_clks) },
+	{ S_CLK_DIV,  top_pll_div_clks,   ARRAY_SIZE(top_pll_div_clks) },
+	{ S_CLK_MUX,  top_fsys_mux_clks,  ARRAY_SIZE(top_fsys_mux_clks) },
+	{ S_CLK_GATE, top_fsys_gate_clks, ARRAY_SIZE(top_fsys_gate_clks) },
+	{ S_CLK_DIV,  top_fsys_div_clks,  ARRAY_SIZE(top_fsys_div_clks) },
+};
+
+static int exynos7885_cmu_top_probe(struct udevice *dev)
+{
+	return samsung_register_cmu(dev, CMU_TOP, top_cmu_clks,
+				    exynos7885_cmu_top);
+}
+
+static const struct udevice_id exynos7885_cmu_top_ids[] = {
+	{ .compatible = "samsung,exynos7885-cmu-top" },
+	{ }
+};
+
+SAMSUNG_CLK_OPS(exynos7885_cmu_top, CMU_TOP);
+
+U_BOOT_DRIVER(exynos7885_cmu_top) = {
+	.name		= "exynos7885-cmu-top",
+	.id		= UCLASS_CLK,
+	.of_match	= exynos7885_cmu_top_ids,
+	.ops		= &exynos7885_cmu_top_clk_ops,
+	.probe		= exynos7885_cmu_top_probe,
+	.flags		= DM_FLAG_PRE_RELOC,
+};
+
+/* ---- CMU_FSYS (0x13400000) ----------------------------------------- */
+
+/*
+ * PLL_CON0_MUX_CLKCMU_FSYS_*_USER registers live in CMU_FSYS and
+ * work as "user muxes" that choose between oscclk and the clock
+ * delivered from CMU_TOP (dout_fsys_mmc_embd / dout_fsys_bus).
+ * Bit 4 is the mux select; bit 29 ("ignore" bit) disables the clock.
+ */
+#define PLL_CON0_MUX_CLKCMU_FSYS_BUS_USER		0x0100
+#define PLL_CON0_MUX_CLKCMU_FSYS_MMC_EMBD_USER		0x0140
+#define PLL_CON0_MUX_CLKCMU_FSYS_USB30DRD_USER		0x0180
+
+#define CLK_CON_GAT_CLK_FSYS_USB20PHY_CLKCORE		0x200c
+#define CLK_CON_GAT_GOUT_FSYS_MMC_EMBD_I_ACLK		0x2038
+#define CLK_CON_GAT_GOUT_FSYS_MMC_EMBD_SDCLKIN		0x203c
+#define CLK_CON_GAT_GOUT_FSYS_USB30DRD_ACLK_20PHYCTRL	0x2068
+#define CLK_CON_GAT_GOUT_FSYS_USB30DRD_BUS_CLK_EARLY	0x2074
+#define CLK_CON_GAT_GOUT_FSYS_USB30DRD_REF_CLK		0x2078
+
+PNAME(mout_fsys_bus_user_p)	   = { "oscclk", "dout_fsys_bus" };
+PNAME(mout_fsys_mmc_embd_user_p)  = { "oscclk", "dout_fsys_mmc_embd" };
+PNAME(mout_fsys_usb30drd_user_p)  = { "oscclk", "dout_fsys_usb30drd" };
+
+static const struct samsung_mux_clock fsys_mux_clks[] = {
+	MUX(CLK_MOUT_FSYS_BUS_USER, "mout_fsys_bus_user",
+	    mout_fsys_bus_user_p,
+	    PLL_CON0_MUX_CLKCMU_FSYS_BUS_USER, 4, 1),
+	MUX(CLK_MOUT_FSYS_MMC_EMBD_USER, "mout_fsys_mmc_embd_user",
+	    mout_fsys_mmc_embd_user_p,
+	    PLL_CON0_MUX_CLKCMU_FSYS_MMC_EMBD_USER, 4, 1),
+	MUX(CLK_MOUT_FSYS_USB30DRD_USER, "mout_fsys_usb30drd_user",
+	    mout_fsys_usb30drd_user_p,
+	    PLL_CON0_MUX_CLKCMU_FSYS_USB30DRD_USER, 4, 1),
+};
+
+static const struct samsung_gate_clock fsys_gate_clks[] = {
+	GATE(CLK_GOUT_MMC_EMBD_ACLK, "gout_mmc_embd_aclk",
+	     "mout_fsys_bus_user",
+	     CLK_CON_GAT_GOUT_FSYS_MMC_EMBD_I_ACLK, 21,
+	     CLK_SET_RATE_PARENT, 0),
+	GATE(CLK_GOUT_MMC_EMBD_SDCLKIN, "gout_mmc_embd_sdclkin",
+	     "mout_fsys_mmc_embd_user",
+	     CLK_CON_GAT_GOUT_FSYS_MMC_EMBD_SDCLKIN, 21,
+	     CLK_SET_RATE_PARENT, 0),
+	/*
+	 * USB20PHY_CLKCORE is the UTMI reference fed to the PHY analogue.
+	 * Its hardware parent is the USB PLL (pll_1418x, not supported in
+	 * U-Boot), but S-Boot has already locked the PLL and the PHY only
+	 * needs the *oscillator* rate (26 MHz) to select the correct FSEL
+	 * register encoding.  Wire it to oscclk so clk_get_rate() returns
+	 * 26 MHz without touching the PLL.
+	 */
+	GATE(CLK_FSYS_USB20PHY_CLKCORE, "clk_fsys_usb20phy_clkcore",
+	     "oscclk",
+	     CLK_CON_GAT_CLK_FSYS_USB20PHY_CLKCORE, 21, 0, 0),
+	GATE(CLK_FSYS_USB30DRD_ACLK_20PHYCTRL, "clk_fsys_usb30drd_aclk_20phyctrl",
+	     "mout_fsys_bus_user",
+	     CLK_CON_GAT_GOUT_FSYS_USB30DRD_ACLK_20PHYCTRL, 21, 0, 0),
+	GATE(CLK_FSYS_USB30DRD_BUS_CLK_EARLY, "clk_fsys_usb30drd_bus_clk_early",
+	     "mout_fsys_bus_user",
+	     CLK_CON_GAT_GOUT_FSYS_USB30DRD_BUS_CLK_EARLY, 21, 0, 0),
+	GATE(CLK_FSYS_USB30DRD_REF_CLK, "clk_fsys_usb30drd_ref_clk",
+	     "mout_fsys_usb30drd_user",
+	     CLK_CON_GAT_GOUT_FSYS_USB30DRD_REF_CLK, 21, 0, 0),
+};
+
+static const struct samsung_clk_group fsys_cmu_clks[] = {
+	{ S_CLK_MUX,  fsys_mux_clks,  ARRAY_SIZE(fsys_mux_clks) },
+	{ S_CLK_GATE, fsys_gate_clks, ARRAY_SIZE(fsys_gate_clks) },
+};
+
+static int exynos7885_cmu_fsys_probe(struct udevice *dev)
+{
+	return samsung_register_cmu(dev, CMU_FSYS, fsys_cmu_clks,
+				    exynos7885_cmu_top);
+}
+
+static const struct udevice_id exynos7885_cmu_fsys_ids[] = {
+	{ .compatible = "samsung,exynos7885-cmu-fsys" },
+	{ }
+};
+
+SAMSUNG_CLK_OPS(exynos7885_cmu_fsys, CMU_FSYS);
+
+U_BOOT_DRIVER(exynos7885_cmu_fsys) = {
+	.name		= "exynos7885-cmu-fsys",
+	.id		= UCLASS_CLK,
+	.of_match	= exynos7885_cmu_fsys_ids,
+	.ops		= &exynos7885_cmu_fsys_clk_ops,
+	.probe		= exynos7885_cmu_fsys_probe,
+	.flags		= DM_FLAG_PRE_RELOC,
+};
diff --git a/drivers/mmc/dw_mmc.c b/drivers/mmc/dw_mmc.c
index d9c05b223d5..79b027e93f0 100644
--- a/drivers/mmc/dw_mmc.c
+++ b/drivers/mmc/dw_mmc.c
@@ -201,7 +201,7 @@ static int dwmci_fifo_ready(struct dwmci_host *host, u32 bit, u32 *len)
 
 static unsigned int dwmci_get_timeout(struct mmc *mmc, const unsigned int size)
 {
-	unsigned int timeout;
+	unsigned int timeout, min_timeout;
 
 	timeout = size * 8;	/* counting in bits */
 	timeout *= 10;		/* wait 10 times as long */
@@ -211,6 +211,20 @@ static unsigned int dwmci_get_timeout(struct mmc *mmc, const unsigned int size)
 	timeout *= 1000;	/* counting in msec */
 	timeout = (timeout < 1000) ? 1000 : timeout;
 
+	/*
+	 * The computation above assumes the bus actually runs at mmc->clock.
+	 * On platforms where the controller source clock cannot be raised
+	 * (clk_set_rate() returns -ENOSYS), the real throughput is far lower
+	 * than nominal, so the value above can be much too short for large
+	 * transfers and a correct-but-slow write/read spuriously times out.
+	 * Floor the timeout to what the transfer needs at a pessimistic
+	 * ~1 MB/s plus 1 s of slack. This only ever lengthens the timeout, so
+	 * it never affects platforms that already run at full speed.
+	 */
+	min_timeout = size / 1024 + 1000;	/* ~1 MB/s, in msec */
+	if (timeout < min_timeout)
+		timeout = min_timeout;
+
 	return timeout;
 }
 
