 	writel(reg, regs_base + EXYNOS850_DRD_HSP);
 }
 
+/*
+ * Exynos7885 USB DRD PHY init.  The 7885 uses PHY IP v3.0.0 (same USBCON
+ * register map as exynos850) but differs in several key ways:
+ *
+ * - PHY_RST_SEL must be set to put the PHY into SW-controlled reset mode;
+ *   without it, hardware may re-assert PHY reset after DCTL.CSFTRST.
+ * - LINK_SW_RST clears the link-layer state left by S-Boot (Odin/download).
+ * - HSP_EN_UTMISUSPEND | HSP_COMMONONN are SET, matching the downstream v3p1
+ *   enable for common_block_disable=1 (the A40 DT) and the mainline exynos850.
+ */
+static void exynos7885_usbdrd_utmi_init(struct phy *phy)
+{
+	struct exynos_usbdrd_phy *phy_drd = dev_get_priv(phy->dev);
+	void __iomem *regs_base = phy_drd->reg_phy;
+	u32 reg;
+
+	/*
+	 * Disable HWACG: force QACTIVE high so the PHY clock is not gated by the
+	 * Q-channel while we bring the link up (canonical exynos850 first step).
+	 */
+	reg = readl(regs_base + EXYNOS850_DRD_LINKCTRL);
+	reg |= LINKCTRL_FORCE_QACT;
+	writel(reg, regs_base + EXYNOS850_DRD_LINKCTRL);
+
+	/*
+	 * Link reset pulse (downstream v3p1 enable does this for version 03_0_0,
+	 * before asserting PHY reset) — clears link-layer state left by S-Boot.
+	 */
+	reg = readl(regs_base + EXYNOS850_DRD_CLKRST);
+	reg |= CLKRST_LINK_SW_RST;
+	writel(reg, regs_base + EXYNOS850_DRD_CLKRST);
+	udelay(10);
+	reg &= ~CLKRST_LINK_SW_RST;
+	writel(reg, regs_base + EXYNOS850_DRD_CLKRST);
+
+	/* Assert PHY SW reset in SW-controlled mode */
+	reg = readl(regs_base + EXYNOS850_DRD_CLKRST);
+	reg |= CLKRST_PHY_RST_SEL | CLKRST_PHY_SW_RST;
+	writel(reg, regs_base + EXYNOS850_DRD_CLKRST);
+
+	/* Power up PHY analog blocks (clear SIDDQ) */
+	reg = readl(regs_base + EXYNOS850_DRD_HSP_TEST);
+	reg &= ~HSP_TEST_SIDDQ;
+	writel(reg, regs_base + EXYNOS850_DRD_HSP_TEST);
+
+	/* Enable UTMI+: clear forced-suspend/sleep and D+/D- pulldowns */
+	reg = readl(regs_base + EXYNOS850_DRD_UTMI);
+	reg &= ~(UTMI_FORCE_SUSPEND | UTMI_FORCE_SLEEP |
+		 UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN);
+	writel(reg, regs_base + EXYNOS850_DRD_UTMI);
+
+	/*
+	 * HSP: SET EN_UTMISUSPEND | COMMONONN.  Both the mainline exynos850 init
+	 * and the downstream v3p1 enable program these (the latter exactly when
+	 * common_block_disable=1, which the A40 DT sets).  We previously cleared
+	 * them to dodge an EP0 timeout, but that was while the PHY had no refclk
+	 * (EP0 timed out regardless); with PLL_USB now locked, follow the refs.
+	 */
+	reg = readl(regs_base + EXYNOS850_DRD_HSP);
+	reg |= HSP_EN_UTMISUSPEND | HSP_COMMONONN;
+	writel(reg, regs_base + EXYNOS850_DRD_HSP);
+
+	/* Force BVALID/VBUSVALID — no VBUS pad on this device */
+	reg = readl(regs_base + EXYNOS850_DRD_UTMI);
+	reg |= UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID;
+	writel(reg, regs_base + EXYNOS850_DRD_UTMI);
+
+	reg = readl(regs_base + EXYNOS850_DRD_HSP);
+	reg |= HSP_VBUSVLDEXT | HSP_VBUSVLDEXTSEL;
+	writel(reg, regs_base + EXYNOS850_DRD_HSP);
+
+	/*
+	 * Bypass the LINKCTRL bus filter on the VBUS/BVALID inputs (canonical
+	 * exynos850 step, "VBUS Valid and D+ pull-up control by VBUS pad usage").
+	 * This phone has no VBUS pad wired to the PHY (the MUIC owns VBUS), so the
+	 * forced VBUSVALID/BVALID above only reach the link through the bus filter
+	 * if it is bypassed.  Without this the link's filtered vbus_valid never
+	 * asserts and it stays at USBLNKST=Disconnected even though RUNSTOP=1.
+	 */
+	reg = readl(regs_base + EXYNOS850_DRD_LINKCTRL);
+	reg |= FIELD_PREP(LINKCTRL_BUS_FILTER_BYPASS, 0xf);
+	writel(reg, regs_base + EXYNOS850_DRD_LINKCTRL);
+
+	/*
+	 * OVC (over-current) IO select.  The downstream v3p1 enable, for
+	 * use_io_for_ovc=0 (the A40 DT), SETS OCD_U2|OCD_U3 in LINK_PORT — routing
+	 * over-current detection away from the (floating) IO pads.  Left at the
+	 * default the port can sense a false over-current and stay disabled, which
+	 * looks exactly like "link never connects".  We never set this before.
+	 */
+	reg = readl(regs_base + EXYNOS850_DRD_LINKPORT);
+	reg |= LINKPORT_HUB_PORT_SEL_OCD_U3 | LINKPORT_HUB_PORT_SEL_OCD_U2;
+	writel(reg, regs_base + EXYNOS850_DRD_LINKPORT);
+
+	/* PLL frequency select — must be set while PHY is in SW reset */
+	reg = readl(regs_base + EXYNOS850_DRD_SSPPLLCTL);
+	reg &= ~SSPPLLCTL_FSEL;
+	switch (phy_drd->extrefclk) {
+	case EXYNOS5_FSEL_50MHZ:
+		reg |= FIELD_PREP(SSPPLLCTL_FSEL, 7);
+		break;
+	case EXYNOS5_FSEL_26MHZ:
+		reg |= FIELD_PREP(SSPPLLCTL_FSEL, 6);
+		break;
+	case EXYNOS5_FSEL_24MHZ:
+		reg |= FIELD_PREP(SSPPLLCTL_FSEL, 2);
+		break;
+	case EXYNOS5_FSEL_20MHZ:
+		reg |= FIELD_PREP(SSPPLLCTL_FSEL, 1);
+		break;
+	case EXYNOS5_FSEL_19MHZ2:
+		reg |= FIELD_PREP(SSPPLLCTL_FSEL, 0);
+		break;
+	default:
+		dev_warn(phy->dev, "unsupported ref clk: %#.2x\n",
+			 phy_drd->extrefclk);
+		break;
+	}
+	writel(reg, regs_base + EXYNOS850_DRD_SSPPLLCTL);
+
+	/*
+	 * Release PHY SW reset.  Matches the downstream phy_sw_rst_low() for
+	 * version 03_0_0: KEEP PHY_RST_SEL set (stay in SW-controlled reset
+	 * mode), clear PHY_SW_RST and PORT_RST.  We previously added a further
+	 * write clearing PHY_RST_SEL ("return to HW control" / CLKRST=0); the
+	 * working driver never does that, so it's removed.
+	 */
+	udelay(100);
+	reg = readl(regs_base + EXYNOS850_DRD_CLKRST);
+	reg |= CLKRST_PHY_RST_SEL;
+	reg &= ~(CLKRST_PHY_SW_RST | CLKRST_PORT_RST);
+	writel(reg, regs_base + EXYNOS850_DRD_CLKRST);
+	udelay(75);
+
+	/*
+	 * Match the working downstream A40 PHY state (read live from its 4.4
+	 * kernel) for the registers our init didn't set.  HSP_TUNE holds the HS
+	 * squelch threshold + DC levels — at the power-on default the PHY may not
+	 * detect the host's bus activity, so the link never leaves Disconnected.
+	 * Also set HSP_TEST bit19 and LINKCTRL bit16, both set on the working PHY.
+	 */
+	writel(A40_HSP_TUNE_VALUE, regs_base + EXYNOS850_DRD_HSP_TUNE);
+
+	reg = readl(regs_base + EXYNOS850_DRD_HSP_TEST);
+	reg &= ~HSP_TEST_SIDDQ;
+	reg |= BIT(19);
+	writel(reg, regs_base + EXYNOS850_DRD_HSP_TEST);
+
+	reg = readl(regs_base + EXYNOS850_DRD_LINKCTRL);
+	reg |= BIT(16);
+	writel(reg, regs_base + EXYNOS850_DRD_LINKCTRL);
+}
