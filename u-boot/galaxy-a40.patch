+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Exynos7885 pinctrl driver.
+ *
+ * Bank data ported from the Linux exynos7885 pin-controller tables.
+ * Modeled on pinctrl-exynos850.c.
+ */
+
+#include <dm.h>
+#include <dm/pinctrl.h>
+#include "pinctrl-exynos.h"
+
+#define EXYNOS7885_PIN_BANK(pins, reg, id)		\
+	{						\
+		.type		= &exynos7885_bank_type,\
+		.offset		= reg,			\
+		.nr_pins	= pins,			\
+		.name		= id			\
+	}
+
+/* CON, DAT, PUD, DRV */
+static const struct samsung_pin_bank_type exynos7885_bank_type = {
+	.fld_width = { 4, 1, 4, 4, },
+	.reg_offset = { 0x00, 0x04, 0x08, 0x0c, },
+};
+
+static const struct pinctrl_ops exynos7885_pinctrl_ops = {
+	.set_state = exynos_pinctrl_set_state
+};
+
+/* pin banks of exynos7885 pin-controller 0 (ALIVE) */
+static const struct samsung_pin_bank_data exynos7885_pin_banks0[] = {
+	EXYNOS7885_PIN_BANK(3, 0x000, "etc0"),
+	EXYNOS7885_PIN_BANK(3, 0x020, "etc1"),
+	EXYNOS7885_PIN_BANK(8, 0x040, "gpa0"),
+	EXYNOS7885_PIN_BANK(8, 0x060, "gpa1"),
+	EXYNOS7885_PIN_BANK(8, 0x080, "gpa2"),
+	EXYNOS7885_PIN_BANK(5, 0x0a0, "gpq0"),
+};
+
+/* pin banks of exynos7885 pin-controller 1 (DISPAUD) */
+static const struct samsung_pin_bank_data exynos7885_pin_banks1[] = {
+	EXYNOS7885_PIN_BANK(5, 0x000, "gpb0"),
+	EXYNOS7885_PIN_BANK(4, 0x020, "gpb1"),
+	EXYNOS7885_PIN_BANK(5, 0x040, "gpb2"),
+};
+
+/* pin banks of exynos7885 pin-controller 2 (FSYS) */
+static const struct samsung_pin_bank_data exynos7885_pin_banks2[] = {
+	EXYNOS7885_PIN_BANK(4, 0x000, "gpf0"),
+	EXYNOS7885_PIN_BANK(8, 0x020, "gpf2"),
+	EXYNOS7885_PIN_BANK(6, 0x040, "gpf3"),
+	EXYNOS7885_PIN_BANK(6, 0x060, "gpf4"),
+};
+
+/* pin banks of exynos7885 pin-controller 3 (TOP) */
+static const struct samsung_pin_bank_data exynos7885_pin_banks3[] = {
+	EXYNOS7885_PIN_BANK(4, 0x000, "gpp0"),
+	EXYNOS7885_PIN_BANK(3, 0x020, "gpg0"),
+	EXYNOS7885_PIN_BANK(4, 0x040, "gpp1"),
+	EXYNOS7885_PIN_BANK(4, 0x060, "gpp2"),
+	EXYNOS7885_PIN_BANK(3, 0x080, "gpp3"),
+	EXYNOS7885_PIN_BANK(6, 0x0a0, "gpp4"),
+	EXYNOS7885_PIN_BANK(4, 0x0c0, "gpp5"),
+	EXYNOS7885_PIN_BANK(5, 0x0e0, "gpp6"),
+	EXYNOS7885_PIN_BANK(2, 0x100, "gpp7"),
+	EXYNOS7885_PIN_BANK(2, 0x120, "gpp8"),
+	EXYNOS7885_PIN_BANK(8, 0x140, "gpg1"),
+	EXYNOS7885_PIN_BANK(8, 0x160, "gpg2"),
+	EXYNOS7885_PIN_BANK(8, 0x180, "gpg3"),
+	EXYNOS7885_PIN_BANK(2, 0x1a0, "gpg4"),
+	EXYNOS7885_PIN_BANK(4, 0x1c0, "gpc0"),
+	EXYNOS7885_PIN_BANK(8, 0x1e0, "gpc1"),
+	EXYNOS7885_PIN_BANK(8, 0x200, "gpc2"),
+};
+
+static const struct samsung_pin_ctrl exynos7885_pin_ctrl[] = {
+	{
+		/* pin-controller instance 0 ALIVE data */
+		.pin_banks	= exynos7885_pin_banks0,
+		.nr_banks	= ARRAY_SIZE(exynos7885_pin_banks0),
+	}, {
+		/* pin-controller instance 1 DISPAUD data */
+		.pin_banks	= exynos7885_pin_banks1,
+		.nr_banks	= ARRAY_SIZE(exynos7885_pin_banks1),
+	}, {
+		/* pin-controller instance 2 FSYS data */
+		.pin_banks	= exynos7885_pin_banks2,
+		.nr_banks	= ARRAY_SIZE(exynos7885_pin_banks2),
+	}, {
+		/* pin-controller instance 3 TOP data */
+		.pin_banks	= exynos7885_pin_banks3,
+		.nr_banks	= ARRAY_SIZE(exynos7885_pin_banks3),
+	},
+	{/* list terminator */}
+};
+
+static const struct udevice_id exynos7885_pinctrl_ids[] = {
+	{ .compatible = "samsung,exynos7885-pinctrl",
+		.data = (ulong)exynos7885_pin_ctrl },
+	{ }
+};
+
+U_BOOT_DRIVER(pinctrl_exynos7885) = {
+	.name		= "pinctrl_exynos7885",
+	.id		= UCLASS_PINCTRL,
+	.of_match	= exynos7885_pinctrl_ids,
+	.priv_auto	= sizeof(struct exynos_pinctrl_priv),
+	.ops		= &exynos7885_pinctrl_ops,
+	.probe		= exynos_pinctrl_probe,
+	.bind		= exynos_pinctrl_bind,
+};
