index 00000000000..434e3f65a0b
--- /dev/null
+++ b/dts/upstream/src/arm64/exynos/exynos7885-galaxy-a40.dts
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy A40 (SM-A405) device tree source
+ *
+ * Exynos 7904, handled as the Exynos 7885 family.
+ *
+ * Copyright (c) 2026 Mikhael Skvortsov <mikhael.skvortsov@gmail.com>
+ */
+
+/dts-v1/;
+#include "exynos7885.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	model = "Samsung Galaxy A40";
+	compatible = "samsung,a40", "samsung,exynos7885";
+	chassis-type = "handset";
+
+	aliases {
+		mmc0 = &mmc_0;
+		serial0 = &serial_0;
+		serial1 = &serial_1;
+		serial2 = &serial_2;
+	};
+
+	/*
+	 * S-BOOT populates the live banks; these match the downstream A40
+	 * map (3.5 GB low + 2 GB high, same layout as jackpotlte).
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3da00000>,
+		      <0x0 0xc0000000 0x40000000>,
+		      <0x8 0x80000000 0x80000000>;
+	};
+
+	/*
+	 * Pseudo reference clock for the USB DRD PHY.  The PHY driver calls
+	 * clk_get_rate("ref") only to determine the FSEL encoding; the actual
+	 * USB PLL is already locked by S-Boot and is not modelled in U-Boot's
+	 * clock driver.  S-Boot programs the PHY with FSEL=7 (SSPPLLCTL[2:0]=7),
+	 * i.e. a 50 MHz reference clock — confirmed by reading the pristine
+	 * SSPPLLCTL (0x60108887) before re-init.  Provide 50 MHz here so the
+	 * driver selects FSEL=7 to match; forcing 26 MHz left the PHY PLL
+	 * mistuned and the link stuck in USBLNKST=Disconnected.
+	 */
+	usbdrd_phy_ref: clock-usbdrd-phy-ref {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_power &key_voldown &key_volup>;
+
+		key-power {
+			label = "Power";
+			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_POWER>;
+		};
+		key-voldown {
+			label = "Volume Down";
+			gpios = <&gpa1 6 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+		};
+		key-volup {
+			label = "Volume Up";
+			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+		};
+	};
+};
+
+&oscclk {
+	clock-frequency = <26000000>;
+};
+
+&soc {
+	usbdrd: usb@13600000 {
+		compatible = "samsung,exynos7885-dwusb3";
+		clocks = <&cmu_fsys CLK_FSYS_USB30DRD_BUS_CLK_EARLY>,
+			 <&cmu_fsys CLK_FSYS_USB30DRD_REF_CLK>;
+		clock-names = "bus_early", "ref";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x13600000 0x10000>;
+		status = "okay";
+
+		usbdrd_dwc3: usb@0 {
+			compatible = "snps,dwc3";
+			reg = <0x0 0x10000>;
+			interrupts = <GIC_SPI 135 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&usbdrd_phy 0>;
+			phy-names = "usb2-phy";
+			phy_type = "utmi";
+			dr_mode = "peripheral";
+			maximum-speed = "high-speed";
+			snps,quirk-frame-length-adjustment = <0x20>;
+		};
+	};
+
+	usbdrd_phy: phy@135d0000 {
+		compatible = "samsung,exynos7885-usbdrd-phy";
+		reg = <0x135d0000 0x100>;
+		clocks = <&cmu_fsys CLK_FSYS_USB30DRD_ACLK_20PHYCTRL>,
+			 <&usbdrd_phy_ref>;
+		clock-names = "phy", "ref";
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		#phy-cells = <1>;
+		status = "okay";
+	};
+};
+
+&pinctrl_alive {
+	key_power: key-power-pins {
+		samsung,pins = "gpa1-7";
+		samsung,pin-function = <0xf>;	/* EINT */
+		samsung,pin-pud = <0>;		/* no pull */
+		samsung,pin-drv = <0>;
+	};
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa1-6";
+		samsung,pin-function = <0xf>;
+		samsung,pin-pud = <0>;
+		samsung,pin-drv = <0>;
+	};
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa1-5";
+		samsung,pin-function = <0xf>;
+		samsung,pin-pud = <0>;
+		samsung,pin-drv = <0>;
+	};
+};
